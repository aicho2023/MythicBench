# Copy this file to `.env` (same folder) and fill in your keys.
# `.env` is git-ignored, so your keys never get committed.
#
#   cp .env.example .env
#
# Get keys from:
#   Anthropic: https://console.anthropic.com/settings/keys
#   OpenAI:    https://platform.openai.com/api-keys
#   Google:    https://aistudio.google.com/apikey (paid tier: link a billing account)
#   xAI:       https://console.x.ai
#   DeepSeek:  https://platform.deepseek.com/api_keys
#   Alibaba:   https://modelstudio.console.alibabacloud.com (Model Studio, US Virginia region)

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
# Your Model Studio workspace's endpoint, e.g.
# https://<workspace-id>.us-east-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=

# Spend cap for the whole project, in USD. Model runs refuse to spend past it
# (see `python -m mythicsim runs spend`). Each run also has its own --budget-usd.
MYTHICBENCH_TOTAL_BUDGET_USD=500
