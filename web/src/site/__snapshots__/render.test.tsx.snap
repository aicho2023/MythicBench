exports[`v1 as visitors see it > leaderboard table 1`] = `
"<div class="overflow-x-auto">
<table class="w-full min-w-[320px] border-collapse">
<thead>
<tr>
<th class="px-3 pb-3 text-left align-bottom text-[12px] font-medium leading-4 text-fg-muted w-[210px] pb-1 pl-0">Model</th>
<th class="px-3 pb-3 text-left align-bottom text-[12px] font-medium leading-4 text-fg-muted w-[104px] pb-1 text-right">
<span class="block text-fg-muted">Score</span>
<span class="block whitespace-nowrap font-normal text-fg-faint">0 to 100</span>
</th>
<th class="px-3 pb-3 text-left align-bottom text-[12px] font-medium leading-4 text-fg-muted hidden pb-1 pl-8 text-right sm:table-cell">
<span class="block" style="width:160px">
<span class="block text-fg-muted">Each group&#x27;s score</span>
<span class="block whitespace-nowrap font-normal text-fg-faint">one dot per group of five fresh agents</span>
</span>
</th>
<th class="px-3 pb-3 text-left align-bottom text-[12px] font-medium leading-4 text-fg-muted hidden w-[190px] pb-1 text-right md:table-cell">
<span class="block text-fg-muted">Oruth&#x27;s health</span>
<span class="block whitespace-nowrap font-normal text-fg-faint">at the end of the best pull</span>
</th>
<th class="px-3 pb-3 text-left align-bottom text-[12px] font-medium leading-4 text-fg-muted hidden w-[150px] pb-1 text-right lg:table-cell">
<span class="block text-fg-muted">First pull</span>
<span class="block whitespace-nowrap font-normal text-fg-faint">before any learning</span>
</th>
<th class="px-3 pb-3 text-left align-bottom text-[12px] font-medium leading-4 text-fg-muted hidden w-[112px] pb-1 pr-0 text-right sm:table-cell">
<span class="block text-fg-muted">Cost</span>
<span class="block whitespace-nowrap font-normal text-fg-faint">per group</span>
</th>
<th class="w-6" aria-hidden="true">
</th>
</tr>
<tr class="border-b border-line" aria-hidden="true">
<th class="pl-0">
</th>
<th>
</th>
<th class="hidden pb-2 pl-8 sm:table-cell">
